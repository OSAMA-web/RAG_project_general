# Copy this file to .env and fill in your own values.
# .env is loaded automatically (see rag/config.py) and should NOT be committed
# to version control if it contains real secrets.

# Which profile (profiles/<name>/) the app runs as. "general" is a domain-neutral
# document assistant; "air_india" is the original Air India assistant.
APP_PROFILE=general

# Ollama model to use for generation
OLLAMA_MODEL=llama3

# JWT signing secret — MUST be changed to a long random string for anything
# beyond local personal use. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# Free flight-status API (aviationstack.com) — optional, only used by profiles that
# enable the "flight" tool. Flight questions give a clear explanatory message
# instead of crashing if this isn't set.
AVIATIONSTACK_API_KEY=

# Rate limiting for /ask and /ask/stream (per user, sliding window: at most N requests in any rolling window)
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
